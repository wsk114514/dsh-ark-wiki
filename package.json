{
  "name": "dsh-ark-wiki",
  "version": "0.7.1",
  "description": "Arknights (明日方舟) tools for DSH: PRTS Wiki lookup (operators, skills, talents, archives, items, stages, story, worldbook) plus a story-cast based predictor for unreleased characters, alters and banner schedules.",
  "license": "MIT",
  "author": "dsh-ark-wiki contributors",
  "type": "module",
  "main": "lib/index.js",
  "scripts": {
    "test": "node tools/harness.mjs offline",
    "test:live": "node tools/harness.mjs live",
    "data:cast": "node tools/build-story-cast.mjs && node tools/build-story-aliases.mjs",
    "pack:check": "npm pack --dry-run"
  },
  "exports": {
    ".": "./lib/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "data",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wsk114514/dsh-ark-wiki.git"
  },
  "homepage": "https://github.com/wsk114514/dsh-ark-wiki#readme",
  "bugs": {
    "url": "https://github.com/wsk114514/dsh-ark-wiki/issues"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "arknights",
    "明日方舟",
    "prts",
    "wiki",
    "tool"
  ],
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.1-rc.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-tools": "^0.2.1-rc.2"
  },
  "dependencies": {
    "ark-info": "^0.1.1"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-tools": "^0.2.1-rc.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
